---
import { links } from '../../config/links';
import { getFullGraph } from '../../graph';
import { getCopy, getLocale } from '../../i18n/copy';
import { getPageCopy, localePath } from '../page/page-copy';
// /join 與 /en/join 共用。文案：zh-tw.yaml 的 finish.steps（四步驟）＋ join.<locale>.yaml。
import Shell from '../page/Shell.astro';
import IntroBuilder from './IntroBuilder';
import { extractIntroTemplate } from './intro-template';

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const j = getPageCopy('join', locale);
const g = await getFullGraph();

// 自介範本以 mono 為唯一來源；讀不到時不顯示產生器，只連到 Members/README
const introTemplate = extractIntroTemplate(
  g.documents.find((d) => d.path === 'Members/README.md')?.body ?? '',
);
const docUrl = (path: string) => g.documents.find((d) => d.path === path)?.url ?? links.mono;
const refUrl: Record<string, string> = {
  constitution: links.constitution,
  application: links.application,
  membersGuide: links.membersGuide,
  discord: links.discord,
  participation: docUrl('specs/01-制度/[機制]成員參與制度.md'),
  review: docUrl('specs/01-制度/[機制]自介審查.md'),
};
const steps: { name: string; detail: string; link: keyof typeof links }[] = copy.finish.steps;
const stepHref = (k: string) => {
  const v = (links as Record<string, unknown>)[k];
  return typeof v === 'string' ? v : links.mono;
};
const events = g.events.filter((e) => e.status !== 'past');
const L = locale === 'en' ? 'en' : 'zh-tw';
const pad = (n: number) => String(n).padStart(2, '0');
---

<Shell copy={copy} title={j.meta.title} description={j.meta.description}>
  <!-- Hero -->
  <section class="pg-section jn-hero" aria-labelledby="jn-title">
    <div class="container-run jn-hero-grid">
      <div>
        <p class="pg-kicker pg-rise">{j.hero.kicker}</p>
        <h1 id="jn-title" class="pg-display jn-title pg-rise" style="--i:1">
          <span>{j.hero.title}</span>
          <span class="pg-accent">{j.hero.titleAccent}</span>
        </h1>
        <p class="pg-lead jn-lead pg-rise" style="--i:2">{j.hero.body}</p>
        <div class="jn-ctas pg-rise" style="--i:3">
          <a class="pg-btn" href="#builder">{j.hero.ctaPrimary}<span class="pg-arrow" aria-hidden="true">→</span></a>
          <a class="pg-btn pg-btn--ghost" href={links.application} target="_blank" rel="noopener noreferrer"
            >{j.hero.ctaSecondary}<span class="pg-arrow" aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <dl class="jn-facts pg-card pg-rise" style="--i:4">
        <div class="jn-facts-bar" aria-hidden="true">
          <span class="jn-facts-dot"></span>
          <span>RUN · JOIN%</span>
          <span class="jn-facts-time">00:00.00</span>
        </div>
        {
          j.hero.facts.map((f: { k: string; v: string }, i: number) => (
            <div class="jn-fact">
              <dt>
                <span class="jn-fact-no">{pad(i + 1)}</span>
                {f.k}
              </dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 四步驟 -->
  <section class="pg-section" id="steps" aria-labelledby="jn-steps-title">
    <div class="container-run">
      <header class="pg-head pg-head--split">
        <div>
          <p class="pg-kicker">{j.steps.kicker}</p>
          <h2 id="jn-steps-title" class="pg-h2" style="margin-top:1.25rem">{j.steps.title}</h2>
        </div>
        <p class="pg-body">{j.steps.body}</p>
      </header>
      <ol class="jn-route">
        {
          steps.map((s, i) => {
            const last = i === steps.length - 1;
            return (
              <li class:list={['jn-step', last && 'jn-step--final']}>
                <div class="jn-step-node" aria-hidden="true">
                  <span>{pad(i + 1)}</span>
                </div>
                <div class="jn-step-card">
                  <p class="jn-step-tag">
                    Split {pad(i + 1)}
                    {last && <span class="pg-chip pg-chip--sky">{j.steps.final}</span>}
                  </p>
                  <h3 class="jn-step-name">{s.name}</h3>
                  <p class="jn-step-detail">{s.detail}</p>
                  {s.link !== 'founderWords' && <a
                    class="jn-step-link"
                    href={last ? '#builder' : stepHref(s.link)}
                    {...(last ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                  >
                    {last ? j.hero.ctaPrimary : j.steps.open}
                    <span aria-hidden="true">{last ? '↓' : '↗'}</span>
                  </a>}
                  {s.link === 'founderWords' && (
                    <p class="jn-step-docs jn-step-link">
                      <a class="pg-link" href={links.founderWords} target="_blank" rel="noopener noreferrer">
                        {L === 'en' ? 'Founder’s letter' : '創辦人的話'}
                      </a>
                      <a class="pg-link" href={links.constitution} target="_blank" rel="noopener noreferrer">
                        {j.faq.refLabels.constitution}
                      </a>
                      <a class="pg-link" href={links.application} target="_blank" rel="noopener noreferrer">
                        {j.faq.refLabels.application}
                      </a>
                    </p>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- 自介產生器 -->
  <section class="pg-section jn-builder" id="builder" aria-labelledby="jn-builder-title">
    <div class="container-run">
      <header class="pg-head pg-head--split">
        <div>
          <p class="pg-kicker">{j.builder.kicker}</p>
          <h2 id="jn-builder-title" class="pg-h2" style="margin-top:1.25rem">{j.builder.title}</h2>
        </div>
        <div class="jn-builder-intro">
          <p class="pg-body">{j.builder.body}</p>
          <p class="jn-privacy">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
              ><path
                d="M10 2 3.5 4.6v4.6c0 4 2.8 7.4 6.5 8.6 3.7-1.2 6.5-4.6 6.5-8.6V4.6L10 2Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"></path><path
                d="m7.2 10 2 2 3.8-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <span>{j.builder.privacy}</span>
          </p>
        </div>
      </header>
      {introTemplate ? (
        <>
          <IntroBuilder client:visible copy={j.builder} template={introTemplate} />
          <noscript>
            <p class="pg-body" style="margin-top:2rem">
              <a class="pg-link" href={links.membersGuide}>{j.builder.guide} ↗</a>
            </p>
          </noscript>
        </>
      ) : (
        <p class="pg-body" style="margin-top:2rem">
          <a class="pg-link" href={links.membersGuide}>{j.builder.guide} ↗</a>
        </p>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="pg-section" id="faq" aria-labelledby="jn-faq-title">
    <div class="container-run jn-faq-grid">
      <header class="jn-faq-head">
        <p class="pg-kicker">{j.faq.kicker}</p>
        <h2 id="jn-faq-title" class="pg-h2" style="margin-top:1.25rem">{j.faq.title}</h2>
      </header>
      <div class="jn-faq-list">
        {
          j.faq.items.map((item: { q: string; a: string; refs?: string[] }, i: number) => (
            <details class="jn-faq" open={i === 0}>
              <summary>
                <span class="jn-faq-no">{pad(i + 1)}</span>
                <span class="jn-faq-q">{item.q}</span>
                <span class="jn-faq-icon" aria-hidden="true" />
              </summary>
              <div class="jn-faq-a">
                <p>{item.a}</p>
                {item.refs?.length ? (
                  <p class="jn-faq-refs">
                    <span>{j.faq.sources}</span>
                    {item.refs.map((r) => (
                      <a class="pg-chip" href={refUrl[r] ?? links.mono} target="_blank" rel="noopener noreferrer">
                        {j.faq.refLabels[r] ?? r} ↗
                      </a>
                    ))}
                  </p>
                ) : null}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 正在進行的活動 -->
  {
    events.length > 0 && (
      <section class="pg-section jn-events" aria-label={j.event.kicker}>
        <div class="container-run">
          {events.map((e) => (
            <a class="jn-event pg-card" href={e.url ?? links.discord} target="_blank" rel="noopener noreferrer">
              <span class="jn-event-live">
                <span class="jn-event-pulse" aria-hidden="true" />
                {j.event.kicker}
              </span>
              <span class="jn-event-body">
                <span class="jn-event-title">{e.title[L] ?? e.title['zh-tw']}</span>
                {e.summary && <span class="jn-event-summary">{e.summary[L] ?? e.summary['zh-tw']}</span>}
                {e.where && <span class="jn-event-where">{e.where[L] ?? e.where['zh-tw']}</span>}
              </span>
              <span class="pg-btn pg-btn--sm jn-event-cta">
                {j.event.cta}
                <span class="pg-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
          <p class="jn-crosslink">
            <a class="pg-link" href={localePath(locale, '/credits')}>Credits →</a>
          </p>
        </div>
      </section>
    )
  }
</Shell>

<style>
  /* Hero */
  .jn-hero {
    padding-top: clamp(3rem, 8vh, 6rem);
  }
  .jn-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .jn-hero-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 5rem;
    }
  }
  .jn-title {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
  }
  .jn-lead {
    margin-top: 2rem;
  }
  .jn-ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .jn-facts {
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
  }
  .jn-facts-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-mist-300);
    border-bottom: 1px solid rgb(184 192 224 / 0.1);
  }
  .jn-facts-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-sky-400);
    box-shadow: 0 0 10px var(--color-sky-400);
  }
  .jn-facts-time {
    margin-left: auto;
    color: var(--color-sky-200);
    font-variant-numeric: tabular-nums;
  }
  .jn-fact {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid rgb(184 192 224 / 0.08);
  }
  .jn-fact:last-child {
    border-bottom: 0;
  }
  .jn-fact dt {
    display: flex;
    gap: 0.8rem;
    font-size: 0.78rem;
    color: var(--color-mist-500);
    letter-spacing: 0.06em;
  }
  .jn-fact-no {
    color: var(--color-lavender-300);
  }
  .jn-fact dd {
    margin: 0;
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--color-snow-50);
    text-align: right;
  }

  /* Route */
  .jn-route {
    position: relative;
    display: grid;
    gap: 1rem;
    counter-reset: step;
  }
  @media (min-width: 900px) {
    .jn-route {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .jn-route::before {
      content: '';
      position: absolute;
      top: 1.5rem;
      left: 1.5rem;
      right: 1.5rem;
      height: 1px;
      background: linear-gradient(90deg, rgb(206 171 253 / 0.5), rgb(30 71 243 / 0.6), rgb(25 172 254 / 0.9));
      box-shadow: 0 0 12px rgb(25 172 254 / 0.5);
    }
  }
  .jn-step {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 899px) {
    .jn-step {
      grid-template-columns: 3rem 1fr;
      grid-template-rows: auto;
      gap: 1rem;
    }
    .jn-step:not(:last-child)::before {
      content: '';
      position: absolute;
      left: 1.5rem;
      top: 3rem;
      bottom: -1rem;
      width: 1px;
      background: linear-gradient(180deg, rgb(206 171 253 / 0.5), rgb(25 172 254 / 0.6));
    }
  }
  .jn-step-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-snow-50);
    background: var(--color-night-900);
    box-shadow:
      inset 0 0 0 1px rgb(206 171 253 / 0.45),
      0 0 0 6px var(--color-night-950);
  }
  .jn-step--final .jn-step-node {
    background: var(--gradient-brand);
    box-shadow:
      0 0 0 6px var(--color-night-950),
      0 0 30px rgb(25 172 254 / 0.7);
  }
  .jn-step-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 18px;
    background: rgb(13 18 60 / 0.5);
    box-shadow: inset 0 0 0 1px rgb(184 192 224 / 0.1);
    transition:
      box-shadow 0.4s var(--ease-run),
      transform 0.4s var(--ease-run);
  }
  .jn-step-card:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px rgb(206 171 253 / 0.4);
  }
  .jn-step--final .jn-step-card {
    background:
      linear-gradient(160deg, rgb(56 12 116 / 0.45), rgb(14 45 166 / 0.3) 60%, rgb(25 172 254 / 0.15)) padding-box;
    box-shadow:
      inset 0 0 0 1px rgb(25 172 254 / 0.45),
      0 30px 80px -40px rgb(25 172 254 / 0.6);
  }
  .jn-step-tag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-mist-500);
  }
  .jn-step-name {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .jn-step-detail {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--color-mist-300);
  }
  .jn-step-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-sky-200);
  }
  .jn-step-link:hover {
    color: var(--color-snow-50);
  }
  .jn-step-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.8rem;
  }

  /* Builder */
  .jn-builder {
    background: linear-gradient(180deg, transparent, rgb(11 15 56 / 0.55) 20%, rgb(11 15 56 / 0.55) 80%, transparent);
  }
  .jn-builder-intro {
    display: grid;
    gap: 1rem;
  }
  .jn-privacy {
    display: flex;
    gap: 0.7rem;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--color-sky-200);
  }
  .jn-privacy svg {
    flex: none;
    margin-top: 0.2rem;
  }

  /* FAQ */
  .jn-faq-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .jn-faq-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 5rem;
    }
    .jn-faq-head {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }
  .jn-faq-list {
    border-top: 1px solid rgb(184 192 224 / 0.14);
  }
  .jn-faq {
    border-bottom: 1px solid rgb(184 192 224 / 0.14);
  }
  .jn-faq summary {
    display: grid;
    grid-template-columns: 2.75rem 1fr 1.5rem;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }
  .jn-faq summary::-webkit-details-marker {
    display: none;
  }
  .jn-faq-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-sky-200);
  }
  .jn-faq-q {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.5;
    transition: color 0.2s;
  }
  .jn-faq summary:hover .jn-faq-q {
    color: var(--color-lavender-100);
  }
  .jn-faq-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    align-self: center;
  }
  .jn-faq-icon::before,
  .jn-faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--color-mist-300);
    transition: transform 0.4s var(--ease-run);
  }
  .jn-faq-icon::after {
    transform: rotate(90deg);
  }
  .jn-faq[open] .jn-faq-icon::after {
    transform: rotate(0deg);
  }
  .jn-faq-a {
    padding: 0 2rem 1.75rem 3.25rem;
    font-size: 1rem;
    line-height: 1.9;
    color: var(--color-mist-300);
  }
  .jn-faq-refs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mist-500);
  }
  .jn-faq-refs .pg-chip {
    font-family: var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
  }
  .jn-faq-refs .pg-chip:hover {
    color: var(--color-snow-50);
  }
  @media (max-width: 640px) {
    .jn-faq-a {
      padding-left: 0;
      padding-right: 0;
    }
  }

  /* Event */
  .jn-events {
    padding-top: 0;
    border-top: 0 !important;
  }
  .jn-event {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    align-items: center;
    transition: transform 0.5s var(--ease-run);
  }
  .jn-event:hover {
    transform: translateY(-3px);
  }
  @media (min-width: 900px) {
    .jn-event {
      grid-template-columns: auto 1fr auto;
      gap: 2.5rem;
    }
  }
  .jn-event-live {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-sky-200);
  }
  .jn-event-pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-sky-400);
    box-shadow: 0 0 0 0 rgb(25 172 254 / 0.6);
    animation: jn-pulse 2s var(--ease-run) infinite;
  }
  @keyframes jn-pulse {
    70% {
      box-shadow: 0 0 0 10px rgb(25 172 254 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(25 172 254 / 0);
    }
  }
  .jn-event-body {
    display: grid;
    gap: 0.4rem;
  }
  .jn-event-title {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.35;
  }
  .jn-event-summary {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-mist-300);
  }
  .jn-event-where {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-mist-500);
  }
  .jn-event-cta {
    justify-self: start;
  }
  .jn-crosslink {
    margin-top: 2rem;
    text-align: right;
    font-size: 0.9rem;
  }
</style>
