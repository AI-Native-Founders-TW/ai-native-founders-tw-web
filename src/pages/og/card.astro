---
import { getCopy } from '../../i18n/copy';
// OG 圖的產生頁（noindex）。文案或品牌更新後重新截圖：
//   node scripts/shot.mjs 不適用（固定 1440 寬）；用 playwright 以 1200×630 截 #og 即可，輸出到 public/og/default.png。
import Base from '../../layouts/Base.astro';

const copy = getCopy('zh-tw');
const h = copy.hero;
const lines: string[] =
  Array.isArray(h.titleLines) && h.titleLines.join('') === h.title ? h.titleLines : [h.title];
---

<Base bare noindex title={`OG · ${copy.meta.title}`}>
  <div id="og" class="og">
    <img class="og__ribbon" src="/stage/ribbon.webp" alt="" width="1600" height="1600" />
    <span class="og__dot"></span>
    <div class="og__copy">
      <p class="og__brand">
        <img src="/brand/logo-512.png" alt="" width="44" height="44" />
        <span>AI-Native Global Founders<br />Speedrun Taiwan</span>
      </p>
      <h1 class="og__title">
        <span>{lines[0]}</span>
        <span class="og__accent">{lines.slice(1).join('')}</span>
      </h1>
      <p class="og__meta">
        <span class="og__chip"><i></i>RUN 00:00.000</span>
        <span>{h.open}</span>
      </p>
    </div>
  </div>
</Base>

<style>
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background:
      radial-gradient(70% 80% at 0% 100%, rgb(56 12 116 / 0.65), transparent 70%),
      radial-gradient(60% 70% at 100% 0%, rgb(30 71 243 / 0.4), transparent 70%),
      #070a26;
    --S: 640px;
    --cx: 900px;
    --cy: 330px;
  }
  .og__ribbon {
    position: absolute;
    width: calc(var(--S) * 2);
    height: calc(var(--S) * 2);
    left: calc(var(--cx) - var(--S));
    top: calc(var(--cy) - var(--S));
    max-width: none;
    mix-blend-mode: screen;
  }
  .og__dot {
    position: absolute;
    --d: calc(var(--S) * 46 / 512);
    width: var(--d);
    height: var(--d);
    left: calc(var(--cx) + 0.28125 * var(--S) - var(--d) / 2);
    top: calc(var(--cy) - 0.1289 * var(--S) - var(--d) / 2);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #fff 0%, #f3ecff 22%, #decffe 48%, #b7a1f7 78%, #9c86f0 100%);
    box-shadow: 0 0 20px rgb(222 207 254 / 0.8), 0 0 60px rgb(160 140 255 / 0.55);
  }
  .og__copy {
    position: absolute;
    inset: 0;
    padding: 64px 72px;
    display: flex;
    flex-direction: column;
    background: radial-gradient(70% 90% at 10% 60%, rgb(7 10 38 / 0.75), transparent 70%);
  }
  .og__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-snow-50);
  }
  .og__brand img {
    border-radius: 50%;
    box-shadow: 0 0 24px rgb(77 71 254 / 0.8);
  }
  .og__title {
    margin: auto 0 0;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 76px;
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.035em;
    font-feature-settings: 'palt';
    color: var(--color-snow-50);
  }
  .og__title span {
    display: block;
  }
  .og__accent {
    background: linear-gradient(100deg, #f6fbfc 0%, #decffe 40%, #8fd8ff 80%, #19acfe 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .og__meta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 34px 0 0;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.1em;
    color: var(--color-mist-300);
  }
  .og__chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-radius: 999px;
    color: var(--color-snow-50);
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.14);
  }
  .og__chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #19acfe;
    box-shadow: 0 0 10px #19acfe;
  }
</style>
