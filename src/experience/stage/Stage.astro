---
// 舞台：全站唯一的背景層。
// 1. CSS／SVG 光帶（SSR，永遠存在）：low 品質與減少動態時的正式畫面，也是 WebGL 載入前的底圖。
// 2. WebGL 光帶（high／mid）：首屏與開場結束後才動態載入 Three.js，淡入覆蓋在上面。
// 3. 光點：Logo 右上的那顆點。觸控裝置在這裡呼吸；桌機的游標光點從這裡出發。
// 位置由 CSS 變數 --S／--cx／--cy 決定，WebGL 讀 .stage__mark 的實際位置，兩者永遠對齊。
---

<div id="stage" class="stage" aria-hidden="true" data-mode="css">
  <div class="stage__bg"></div>
  <div class="stage__blob stage__blob--a"></div>
  <div class="stage__blob stage__blob--b"></div>
  <div class="stage__blob stage__blob--c"></div>

  <!-- 量測用的 512 盒子（WebGL 依此對齊） -->
  <div class="stage__mark"></div>
  <!-- 烘焙自 WebGL 光帶的靜態畫面：low／減少動態的正式畫面，也是 WebGL 載入前的底圖 -->
  <div class="stage__art">
  <!-- 光暈用預先模糊好的圖（scripts：ffmpeg gblur），不在瀏覽器裡每幀算 blur -->
  <img class="stage__bake stage__bake--glow" src="/stage/ribbon-glow.webp" alt="" width="1600" height="1600" decoding="async" />
  <img class="stage__bake" src="/stage/ribbon.webp" alt="" width="1600" height="1600" decoding="async" fetchpriority="high" />
  </div>

  <canvas class="stage__gl"></canvas>
  <div class="stage__grain"></div>
  <div class="stage__art stage__art--dot"><span class="stage__dot"><i></i></span></div>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    opacity: var(--stage-o, 1);
    /* 光帶 A 的位置與大小（global.css 的 --mark-*，開場共用） */
    --S: var(--mark-S);
    --cx: var(--mark-cx);
    --cy: var(--mark-cy);
  }

  .stage__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 0% 100%, rgb(56 12 116 / 0.55), transparent 70%),
      radial-gradient(55% 55% at 100% 0%, rgb(30 71 243 / 0.32), transparent 70%),
      radial-gradient(50% 50% at var(--cx) var(--cy), rgb(77 71 254 / 0.16), transparent 70%),
      var(--color-night-950);
  }

  /* 光斑：不用 filter: blur()。瀏覽器會對這三個 40vmax 的圖層每幀重算 90px 高斯模糊，
     量測下佔了 Hero 近一半的繪圖成本；改用多段漸層，柔邊一樣、成本為零。 */
  .stage__blob {
    position: absolute;
    border-radius: 50%;
    opacity: 0.55;
    will-change: transform;
    mix-blend-mode: screen;
    background: radial-gradient(
      circle closest-side,
      rgb(var(--c) / 0.95) 0%,
      rgb(var(--c) / 0.62) 24%,
      rgb(var(--c) / 0.3) 50%,
      rgb(var(--c) / 0.1) 76%,
      transparent 100%
    );
  }
  .stage__blob--a {
    --c: 77 71 254;
    width: 46vmax;
    height: 46vmax;
    left: calc(var(--cx) - 30vmax);
    top: calc(var(--cy) - 18vmax);
    animation: blob-a 22s ease-in-out infinite alternate;
  }
  .stage__blob--b {
    --c: 25 172 254;
    width: 36vmax;
    height: 36vmax;
    left: calc(var(--cx) - 4vmax);
    top: calc(var(--cy) + 2vmax);
    opacity: 0.35;
    animation: blob-b 26s ease-in-out infinite alternate;
  }
  .stage__blob--c {
    --c: 106 43 217;
    width: 40vmax;
    height: 40vmax;
    left: -14vmax;
    bottom: -18vmax;
    opacity: 0.4;
    animation: blob-c 30s ease-in-out infinite alternate;
  }
  @keyframes blob-a {
    to { transform: translate3d(6vmax, 5vmax, 0) scale(1.12); }
  }
  @keyframes blob-b {
    to { transform: translate3d(-8vmax, -6vmax, 0) scale(0.9); }
  }
  @keyframes blob-c {
    to { transform: translate3d(10vmax, -4vmax, 0) scale(1.15); }
  }

  .stage__mark {
    position: absolute;
    width: var(--S);
    height: var(--S);
    left: calc(var(--cx) - var(--S) / 2);
    top: calc(var(--cy) - var(--S) / 2);
    visibility: hidden;
  }
  .stage__art {
    position: absolute;
    inset: 0;
    opacity: var(--art-o, 1);
  }
  /* 烘焙圖是 2S 見方、以 A 的盒子為中心；黑底用 screen 疊上去 */
  .stage__bake {
    position: absolute;
    width: calc(var(--S) * 2);
    height: calc(var(--S) * 2);
    left: calc(var(--cx) - var(--S));
    top: calc(var(--cy) - var(--S));
    max-width: none;
    mix-blend-mode: screen;
    transform-origin: 50% 45%;
    animation: bake-drift 11s ease-in-out infinite alternate;
    transition: opacity 1.4s var(--ease-run);
  }
  .stage__bake--glow {
    opacity: 0.5;
    animation: bake-glow 6s ease-in-out infinite alternate;
  }
  @keyframes bake-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg) scale(1); }
    to { transform: translate3d(-0.6%, 0.8%, 0) rotate(-0.8deg) scale(1.018); }
  }
  @keyframes bake-glow {
    from { opacity: 0.25; }
    to { opacity: 0.7; }
  }

  .stage__gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-run);
  }
  .stage[data-mode='gl'] .stage__gl {
    opacity: 1;
  }
  /* WebGL 接手後，把 CSS 層的動畫停掉（省電），SVG 留著讓 WebGL 讀位置 */
  .stage[data-mode='gl'] :is(.stage__blob, .stage__bake) {
    animation-play-state: paused;
  }
  .stage[data-mode='gl'] .stage__bake {
    opacity: 0;
  }

  .stage__grain {
    position: absolute;
    inset: -50%;
    opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: overlay;
  }
  .stage[data-mode='gl'] .stage__grain {
    display: none;
  }

  /* Logo 的光點：觸控裝置與游標尚未移動前，在這裡呼吸 */
  .stage__dot {
    position: absolute;
    --d: calc(var(--S) * 46 / 512);
    width: var(--d);
    height: var(--d);
    left: calc(var(--cx) + 0.28125 * var(--S) - var(--d) / 2);
    top: calc(var(--cy) - 0.1289 * var(--S) - var(--d) / 2);
    border-radius: 50%;
    background:
      radial-gradient(circle at 38% 34%, #ffffff 0%, #f3ecff 22%, #decffe 48%, #b7a1f7 78%, #9c86f0 100%);
    box-shadow:
      inset -6px -8px 18px rgb(77 71 254 / 0.35),
      inset 4px 5px 12px rgb(255 255 255 / 0.6),
      0 0 calc(var(--d) * 0.35) rgb(222 207 254 / 0.8),
      0 0 calc(var(--d) * 1.2) rgb(160 140 255 / 0.55),
      0 0 calc(var(--d) * 2.6) rgb(77 71 254 / 0.35);
    transition: opacity 0.6s var(--ease-run), scale 0.6s var(--ease-run);
    animation: dot-breathe 3.6s ease-in-out infinite;
  }
  .stage__dot i {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    border: 1px solid rgb(222 207 254 / 0.4);
    animation: dot-ring 3.6s cubic-bezier(0.2, 0.6, 0.2, 1) infinite;
  }
  @keyframes dot-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }
  @keyframes dot-ring {
    0% { transform: scale(0.95); opacity: 0; }
    15% { opacity: 0.55; }
    100% { transform: scale(1.45); opacity: 0; }
  }
  /* 桌機：游標光點接手之後，Logo 上的點交出去 */
  :global(html.orb-live) .stage__dot {
    opacity: 0;
    scale: 0.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__blob, .stage__bake, .stage__dot, .stage__dot i { animation: none !important; }
  }
  :global(html[data-motion='reduced']) .stage :is(.stage__blob, .stage__bake, .stage__dot, .stage__dot i) {
    animation: none;
  }
</style>

<script>
  import { initStage } from './index';
  initStage();
</script>
