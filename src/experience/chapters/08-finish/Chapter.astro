---
import { links } from '../../../config/links';
// 章節 08：終點線。四個檢查點是一條賽道；捲動時光點沿賽道前進、衝線、停表。
// 這是主要轉換點：每個檢查點整張卡都可以點，主 CTA 永遠在賽道正下方。
import { type Copy, getLocale, localePath } from '../../../i18n/copy';
import { phrases } from '../../engine/phrase';

const ph = (t: string) => phrases(t);
interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const f = copy.finish;
type Step = { name: string; detail: string; link: keyof typeof links };
const steps = (f.steps as Step[]).map((s) => ({
  ...s,
  href: typeof links[s.link] === 'string' ? (links[s.link] as string) : links.mono,
}));
// 中文標題只在「，」之後斷行（每段是 inline-block）
const titleSegs = String(f.title).split(/(?<=，)/);
const arrow = 'M3 8h10M9 4l4 4-4 4';
const ext = 'M5 11 11 5M6 5h5v5';
---

<section id="ch-08" data-split="08" data-split-name={copy.hud.splits['08']} class="fin">
  <div class="fin__glow" aria-hidden="true"></div>
  <div class="container-run fin__wrap">
    <header class="fin__head">
      <p class="kicker-run">{f.kicker}</p>
      <h2 class="fin__title">{titleSegs.map((t) => <span>{t}</span>)}</h2>
      <p class="fin__body">{ph(f.body).map((w) => (w.trim() ? <span class="phrase">{w}</span> : w))}</p>
    </header>

    <div class="fin__race" data-race style="--p:1">
      <div class="fin__rail" aria-hidden="true">
        <span class="fin__rail-fill"></span>
        <span class="fin__start">{f.start}</span>
        <span class="fin__goal"><i></i>{f.goal}</span>
        <span class="fin__runner"><b></b></span>
      </div>

      <ol class="fin__steps">
        {steps.map((s, i) => (
          <li class="fin__step" data-step={i}>
            <span class="fin__cp" aria-hidden="true">
              <span>{String(i + 1).padStart(2, '0')}</span>
            </span>
            <a class="fin__card" href={s.href} target="_blank" rel="noopener">
              <span class="fin__card-cp" aria-hidden="true">{f.checkpoint} {String(i + 1).padStart(2, '0')}</span>
              <span class="fin__card-name">{s.name}</span>
              <span class="fin__card-detail">{ph(s.detail).map((w) => (w.trim() ? <span class="phrase">{w}</span> : w))}</span>
              <span class="fin__card-go">
                {f.stepCta}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ext} /></svg>
                <span class="sr-only">{copy.meta.newTab}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="fin__line" aria-hidden="true">
      <span class="fin__line-flag"></span>
      <span class="fin__line-label">{f.resultLabel}</span>
      <span class="fin__line-time" data-result>00:00.000</span>
      <span class="fin__line-stamp">{f.timerStop}</span>
      <span class="fin__line-note">{f.resultNote}</span>
    </div>

    <div class="fin__cta-row">
      <div class="fin__ctas">
        <a href={localePath(locale, '/join')} class="btn-run btn-run--primary fin__primary" data-magnetic>
          <span>{f.ctaPrimary}</span>
          <span class="btn-run__icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </a>
        <a href={links.discord} target="_blank" rel="noopener" class="btn-run btn-run--ghost" data-magnetic>
          <span>{f.ctaSecondary}<span class="sr-only">{copy.meta.newTab}</span></span>
          <span class="btn-run__icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /></svg>
          </span>
        </a>
      </div>

      <a class="fin__event" href={links.eventThread} target="_blank" rel="noopener">
        <span class="fin__event-live"><i aria-hidden="true"></i>{f.event.label}</span>
        <span class="fin__event-title">{ph(f.event.title).map((w) => (w.trim() ? <span class="phrase">{w}</span> : w))}</span>
        <span class="fin__event-body">{f.event.body}</span>
        <span class="fin__event-cta">
          {f.event.cta}
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ext} /></svg>
          <span class="fin__event-via">{f.event.via}</span>
          <span class="sr-only">{copy.meta.newTab}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .fin {
    position: relative;
    padding: clamp(96px, 16vh, 180px) 0 clamp(96px, 14vh, 160px);
    overflow: clip;
  }
  .fin__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 50% 55%, rgb(77 71 254 / 0.14), transparent 70%),
      linear-gradient(180deg, rgb(7 10 38 / 0.6), transparent 30%, transparent 70%, rgb(7 10 38 / 0.7));
  }
  .fin__wrap {
    position: relative;
  }

  .fin__head {
    max-width: 60rem;
  }
  .fin__title {
    margin: 22px 0 0;
    font-family: 'Noto Sans TC', var(--font-display);
    font-size: clamp(2.5rem, 5.6vw, 5.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-feature-settings: 'palt';
  }
  .fin__title span {
    display: inline-block;
  }
  .fin__body {
    max-width: 36em;
    margin: 22px 0 0;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.8;
    color: var(--color-mist-300);
    text-wrap: pretty;
  }

  /* 終點線：衝線後在這裡出現成績（空間預留，不造成版面位移） */
  .fin__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 16px;
    row-gap: 6px;
    margin-top: clamp(36px, 5vh, 52px);
    padding: 16px 20px 16px 0;
    border-block: 1px solid rgb(255 255 255 / 0.07);
    font-family: var(--font-mono);
  }
  .fin__line-flag {
    align-self: stretch;
    width: 12px;
    min-height: 40px;
    margin-right: 4px;
    border-radius: 2px;
    background: conic-gradient(#f6fbfc 25%, #0b0f38 0 50%, #f6fbfc 0 75%, #0b0f38 0) 0 0 / 6px 6px;
    opacity: 0.35;
    transition: opacity 0.6s var(--ease-run);
  }
  .fin__line-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-mist-500);
  }
  .fin__line-time {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.18);
    transition: color 0.6s;
  }
  .fin__line-stamp {
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-night-950);
    background: linear-gradient(100deg, #f6fbfc, #decffe 50%, #8fd8ff);
    opacity: 0;
    scale: 0.6;
    transition: opacity 0.4s var(--ease-run) 0.2s, scale 0.7s cubic-bezier(0.34, 1.7, 0.5, 1) 0.2s;
  }
  .fin__line-note {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-mist-500);
    transition: color 0.6s;
  }
  .fin[data-finished] .fin__line-flag {
    opacity: 1;
  }
  .fin[data-finished] .fin__line-time {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fin[data-finished] .fin__line-stamp {
    opacity: 1;
    scale: 1;
  }
  .fin[data-finished] .fin__line-note {
    color: var(--color-mist-300);
  }

  /* ── 賽道 ─────────────────────────────── */
  .fin__race {
    position: relative;
    margin-top: clamp(56px, 9vh, 96px);
    --rail-y: 22px;
  }
  .fin__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--rail-y);
    height: 2px;
    border-radius: 2px;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.18) 0 6px, transparent 6px 12px);
  }
  .fin__rail-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #4d47fe, #19acfe 70%, #decffe);
    box-shadow: 0 0 14px rgb(25 172 254 / 0.7);
    transform-origin: left;
    scale: var(--p) 1;
  }
  .fin__start,
  .fin__goal {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-mist-500);
  }
  .fin__start {
    left: 0;
    translate: 0 -260%;
  }
  .fin__goal {
    right: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    translate: 0 -260%;
    color: var(--color-snow-50);
  }
  .fin__goal i {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    background: conic-gradient(#f6fbfc 25%, #0b0f38 0 50%, #f6fbfc 0 75%, #0b0f38 0) 0 0 / 7px 7px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.4);
  }
  /* 終點的那條線 */
  .fin__goal::after {
    content: '';
    position: absolute;
    right: 0;
    top: 100%;
    width: 2px;
    height: 34px;
    margin-top: 4px;
    background: repeating-linear-gradient(180deg, #f6fbfc 0 4px, #0b0f38 4px 8px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
  }
  .fin__runner {
    position: absolute;
    top: 50%;
    left: calc(var(--p) * 100%);
    width: 0;
    height: 0;
  }
  .fin__runner b {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0%, #decffe 50%, #b9a3f5 100%);
    box-shadow: 0 0 14px rgb(222 207 254 / 0.95), 0 0 40px rgb(77 71 254 / 0.9);
  }
  .fin__runner::before {
    /* 拖尾 */
    content: '';
    position: absolute;
    right: 0;
    top: -1px;
    width: 120px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(222 207 254 / 0.9));
    filter: blur(1px);
  }
  .fin[data-finished] .fin__runner::after {
    content: '';
    position: absolute;
    left: -40px;
    top: -40px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid #decffe;
    animation: fin-burst 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes fin-burst {
    from { scale: 0.2; opacity: 1; }
    to { scale: 3; opacity: 0; }
  }

  .fin__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fin__step {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 26px;
  }
  .fin__cp {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-left: 22px;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-mist-300);
    background: var(--color-night-900);
    border: 1px solid rgb(255 255 255 / 0.16);
    transition: color 0.5s, background 0.5s, border-color 0.5s, box-shadow 0.6s var(--ease-run), scale 0.6s cubic-bezier(0.34, 1.7, 0.5, 1);
  }
  .fin__step[data-passed] .fin__cp {
    color: var(--color-night-950);
    background: linear-gradient(135deg, #f6fbfc, #decffe 50%, #8fd8ff);
    border-color: transparent;
    box-shadow: 0 0 0 6px rgb(222 207 254 / 0.12), 0 0 30px rgb(77 71 254 / 0.8);
    scale: 1.06;
  }

  .fin__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 22px 22px 20px;
    border-radius: 20px;
    color: var(--color-snow-50);
    text-decoration: none;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015)), rgb(11 15 56 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.09);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.5s var(--ease-run), background-color 0.5s, translate 0.6s var(--ease-run), box-shadow 0.6s var(--ease-run);
  }
  .fin__card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg, rgb(222 207 254 / 0.8), rgb(77 71 254 / 0.4) 40%, transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.6s var(--ease-run);
    pointer-events: none;
  }
  .fin__step[data-passed] .fin__card::before {
    opacity: 1;
  }
  .fin__card:hover,
  .fin__card:focus-visible {
    translate: 0 -4px;
    border-color: rgb(222 207 254 / 0.35);
    box-shadow: 0 24px 50px -24px rgb(77 71 254 / 0.8);
  }
  .fin__card-cp {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--color-sky-400);
  }
  .fin__card-name {
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .fin__card-detail {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-mist-300);
  }
  .fin__card-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-lavender-100);
  }
  .fin__card-go svg {
    transition: translate 0.4s var(--ease-run);
  }
  .fin__card:hover .fin__card-go svg {
    translate: 2px -2px;
  }

  /* ── CTA 與活動 ─────────────────────── */
  .fin__cta-row {
    display: grid;
    grid-template-columns: auto minmax(0, 440px);
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: clamp(48px, 7vh, 80px);
  }
  .fin__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .fin__primary {
    --h: 64px;
    padding-left: 32px;
    font-size: 17px;
  }
  .fin[data-finished] .fin__primary {
    animation: fin-call 2.4s var(--ease-run) 0.4s 2;
  }
  @keyframes fin-call {
    0%, 100% { box-shadow: 0 0 0 1px rgb(255 255 255 / 0.5) inset, 0 10px 30px -8px rgb(140 120 255 / 0.55), 0 0 0 0 rgb(222 207 254 / 0.6); }
    50% { box-shadow: 0 0 0 1px rgb(255 255 255 / 0.5) inset, 0 10px 30px -8px rgb(140 120 255 / 0.55), 0 0 0 14px rgb(222 207 254 / 0); }
  }

  .fin__event {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-radius: 18px;
    color: var(--color-snow-50);
    text-decoration: none;
    background: linear-gradient(135deg, rgb(56 12 116 / 0.45), rgb(30 71 243 / 0.25));
    border: 1px solid rgb(206 171 253 / 0.25);
    transition: border-color 0.5s, translate 0.6s var(--ease-run);
  }
  .fin__event:hover,
  .fin__event:focus-visible {
    border-color: rgb(222 207 254 / 0.6);
    translate: 0 -3px;
  }
  .fin__event-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-lavender-100);
  }
  .fin__event-live i {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6ff0b0;
    box-shadow: 0 0 8px #6ff0b0;
  }
  .fin__event-live i::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid #6ff0b0;
    animation: live 1.8s ease-out infinite;
  }
  @keyframes live {
    from { scale: 0.4; opacity: 1; }
    to { scale: 1.6; opacity: 0; }
  }
  .fin__event-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.45;
  }
  .fin__event-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-mist-300);
  }
  .fin__event-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-snow-50);
  }
  .fin__event-via {
    margin-left: 6px;
    font-weight: 400;
    font-size: 12px;
    color: var(--color-mist-500);
  }

  /* ── 平板與手機：直式賽道 ───────────────── */
  @media (max-width: 899px) {
    .fin__line {
      padding-right: 0;
    }
    .fin__line-note {
      flex-basis: 100%;
      margin-left: 32px;
    }
    .fin__race {
      --rail-x: 22px;
      margin-top: 56px;
      padding-top: 30px;
      padding-bottom: 46px;
    }
    .fin__rail {
      left: var(--rail-x);
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, rgb(255 255 255 / 0.18) 0 6px, transparent 6px 12px);
    }
    .fin__rail-fill {
      background: linear-gradient(180deg, #4d47fe, #19acfe 70%, #decffe);
      transform-origin: top;
      scale: 1 var(--p);
    }
    .fin__start {
      left: 0;
      top: 0;
      translate: 14px 0;
    }
    .fin__goal {
      right: auto;
      left: 0;
      top: auto;
      bottom: 0;
      translate: 14px 0;
    }
    .fin__goal::after {
      top: auto;
      bottom: 50%;
      right: auto;
      left: -26px;
      width: 52px;
      height: 2px;
      margin: 0;
      translate: 0 50%;
      background: repeating-linear-gradient(90deg, #f6fbfc 0 4px, #0b0f38 4px 8px);
    }
    .fin__goal i {
      display: none;
    }
    .fin__runner {
      left: 50%;
      top: calc(var(--p) * 100%);
    }
    .fin__runner::before {
      right: auto;
      left: -1px;
      top: auto;
      bottom: 0;
      width: 2px;
      height: 90px;
      background: linear-gradient(180deg, transparent, rgb(222 207 254 / 0.9));
    }
    .fin__steps {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .fin__step {
      grid-template-columns: 46px 1fr;
      grid-template-rows: auto;
      gap: 14px;
    }
    .fin__cp {
      margin: 0;
      width: 46px;
      height: 46px;
    }
    .fin__card {
      padding: 18px 18px 16px;
    }
    .fin__cta-row {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .fin__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .fin__ctas .btn-run {
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fin__event-live i::after { animation: none; }
  }
</style>

<script>
  import { initFinish } from './scene';
  initFinish();
</script>
