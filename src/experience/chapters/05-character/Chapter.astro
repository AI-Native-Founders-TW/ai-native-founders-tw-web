---
// 章節 05：選擇你的起點。遊戲的角色選擇畫面；標題「你不需要準備好。」是全站最重要的一句話。
import type { Copy } from '../../../i18n/copy';
import Badge from './Badge.astro';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.character;
const classes: { id: string; label?: string; name: string; line: string }[] = c.classes;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  id="ch-05"
  data-split="05"
  data-split-name={copy.hud.splits['05']}
  class="ch05 relative isolate overflow-x-clip"
  aria-labelledby="ch05-title"
>
  <!-- 徽章共用漸層（取色自 Logo） -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="ch05-g-light" gradientUnits="userSpaceOnUse" x1="20" y1="104" x2="78" y2="14">
        <stop offset="0" stop-color="#b9a4ff"></stop>
        <stop offset="0.45" stop-color="#decffe"></stop>
        <stop offset="1" stop-color="#f6fbfc"></stop>
      </linearGradient>
      <linearGradient id="ch05-g-blue" gradientUnits="userSpaceOnUse" x1="28" y1="24" x2="104" y2="100">
        <stop offset="0" stop-color="#4d47fe"></stop>
        <stop offset="0.55" stop-color="#1e6bfb"></stop>
        <stop offset="1" stop-color="#19acfe"></stop>
      </linearGradient>
      <radialGradient id="ch05-g-dot" cx="0.35" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#f6fbfc"></stop>
        <stop offset="0.55" stop-color="#decffe"></stop>
        <stop offset="1" stop-color="#9d93f6"></stop>
      </radialGradient>
    </defs>
  </svg>

  <!-- 舞台一：全站最重要的一句話 -->
  <div class="ch05-hero">
    <div class="ch05-halo" aria-hidden="true"></div>
    <p class="ch05-kicker">{c.kicker}</p>
    <h2 id="ch05-title" class="ch05-title" data-ch05-title>{c.title}</h2>
    <p class="ch05-body" data-ch05-body>{c.body}</p>
  </div>

  <!-- 舞台二：角色選擇 -->
  <div class="ch05-select" data-ch05-select>
    <div class="ch05-select-head container-run">
      <p id="ch05-prompt" class="ch05-prompt"><span class="ch05-prompt-dot" aria-hidden="true"></span>{c.prompt}</p>
      <p class="ch05-keys ch05-keys--touch" aria-hidden="true">{c.ui?.swipe}</p>
    </div>

    <div class="ch05-roster-wrap">
      <p class="ch05-backdrop" aria-hidden="true" data-ch05-backdrop>{classes[0]?.label ?? classes[0]?.id}</p>
      <canvas class="ch05-sparks" data-ch05-sparks aria-hidden="true"></canvas>
      <div class="ch05-roster container-run" role="group" aria-labelledby="ch05-prompt" data-ch05-roster>
        {
          classes.map((k, i) => (
            <button
              type="button"
              class="ch05-card"
              data-index={i}
              data-id={k.id}
              data-label={k.label ?? k.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls="ch05-dialog"
            >
              <span class="ch05-card-bg" aria-hidden="true">
                <span class="ch05-card-sweep" />
              </span>
              <span class="ch05-card-inner">
                <span class="ch05-card-num" aria-hidden="true">{pad(i + 1)}</span>
                <span class="ch05-card-id" aria-hidden="true">{k.label ?? k.id}</span>
                <span class="ch05-emblem" aria-hidden="true">
                  <svg class="ch05-ring" viewBox="0 0 200 200" fill="none">
                    <circle cx="100" cy="100" r="92" stroke="currentColor" stroke-width="1" stroke-dasharray="2 6" />
                    <circle cx="100" cy="100" r="78" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <path d="M100 2 L100 14 M100 186 L100 198 M2 100 L14 100 M186 100 L198 100" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                  <Badge id={k.id} />
                </span>
                <span class="ch05-card-name">{k.name}</span>
                <span class="ch05-card-tag" aria-hidden="true">{c.ui?.selected}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ch05-dots" aria-hidden="true" data-ch05-dots>
      {classes.map((_, i) => <span data-active={i === 0 ? 'true' : 'false'} />)}
    </div>

    <div class="container-run">
      <div id="ch05-dialog" class="ch05-dialog" data-ch05-dialog aria-live="polite">
        <span class="ch05-dialog-corner ch05-dialog-corner--tl" aria-hidden="true"></span>
        <span class="ch05-dialog-corner ch05-dialog-corner--br" aria-hidden="true"></span>
        <p class="ch05-keys ch05-keys--desk" aria-hidden="true">{c.ui?.keys}</p>
        {
          classes.map((k, i) => (
            <div class="ch05-panel" data-panel={i} data-active={i === 0 ? 'true' : 'false'}>
              <p class="ch05-plate">
                <span class="ch05-plate-num" aria-hidden="true">{pad(i + 1)}</span>
                <span class="ch05-plate-name">{k.name}</span>
              </p>
              <p class="ch05-line">
                <span class="ch05-line-full">{k.line}</span>
                <span class="ch05-line-typed" aria-hidden="true">
                  <span class="ch05-line-text" />
                  <span class="ch05-caret" />
                </span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initCharacter } from './scene';
  initCharacter();
</script>

<style>
  .ch05 {
    --ch05-skew: -7deg;
    padding-bottom: clamp(5rem, 12vh, 9rem);
  }

  /* ---------- 舞台一：標題 ---------- */
  .ch05-hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 18vh 1.25rem 12vh;
  }
  .ch05-halo {
    position: absolute;
    inset: 10% -10% 0;
    z-index: -1;
    background:
      radial-gradient(40% 36% at 50% 52%, rgb(77 71 254 / 0.22), transparent 70%),
      radial-gradient(22% 20% at 62% 46%, rgb(25 172 254 / 0.12), transparent 70%);
    filter: blur(10px);
    pointer-events: none;
  }
  .ch05-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-mist-300);
    margin-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .ch05-title {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 900;
    font-size: clamp(3.4rem, 10.6vw, 11.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 100%;
    background: linear-gradient(100deg, #f6fbfc 0%, #f6fbfc 38%, #decffe 64%, #8fd8ff 88%, #19acfe 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  /* SplitText 後每個字自己帶一段漸層（background-clip 在拆字後會失效） */
  .ch05-title.is-split {
    background: none;
    color: var(--color-snow-50);
  }
  .ch05-title :global(.ch05-char) {
    display: inline-block;
    background: linear-gradient(100deg, #f6fbfc 0%, #f6fbfc 38%, #decffe 64%, #8fd8ff 88%, #19acfe 100%);
    background-size: var(--ch05-w, 100%) 100%;
    background-position: var(--ch05-x, 0) 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* 句點變成 Logo 的光點：「你」就停在這句話的最後 */
  .ch05-title :global(.ch05-char.is-dot) {
    position: relative;
    color: transparent;
    background: none;
  }
  .ch05-title :global(.ch05-char.is-dot)::after {
    content: '';
    position: absolute;
    left: 0.12em;
    bottom: 0.2em;
    width: 0.2em;
    height: 0.2em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f6fbfc, #decffe 55%, #9d93f6);
    box-shadow:
      0 0 0.12em rgb(222 207 254 / 0.9),
      0 0 0.6em rgb(77 71 254 / 0.55);
    animation: ch05-breathe 3.6s ease-in-out infinite;
  }
  @keyframes ch05-breathe {
    50% {
      box-shadow:
        0 0 0.16em rgb(222 207 254 / 1),
        0 0 0.9em rgb(25 172 254 / 0.6);
    }
  }
  .ch05-body {
    margin-top: clamp(1.75rem, 4vh, 2.75rem);
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1.7;
    color: var(--color-mist-300);
    max-width: 34em;
    text-wrap: balance;
  }

  /* ---------- 舞台二：選擇畫面 ---------- */
  .ch05-select {
    position: relative;
  }
  .ch05-select-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .ch05-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .ch05-prompt-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-lavender-100);
    box-shadow: 0 0 14px rgb(222 207 254 / 0.8);
  }
  .ch05-keys {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-mist-300);
    white-space: pre;
  }
  .ch05-keys--touch {
    display: none;
  }
  .ch05-keys--desk {
    position: absolute;
    right: 1.75rem;
    bottom: 1rem;
    color: var(--color-mist-500);
  }

  .ch05-roster-wrap {
    position: relative;
  }
  /* Persona 式的巨大背景字：目前角色的代號 */
  .ch05-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: -1;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 19vw, 19rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(184 192 224 / 0.16);
    background: linear-gradient(180deg, rgb(77 71 254 / 0.12), transparent 70%);
    -webkit-background-clip: text;
    background-clip: text;
    pointer-events: none;
    user-select: none;
  }
  .ch05-sparks {
    position: absolute;
    left: 0;
    top: -80px;
    width: 100%;
    height: calc(100% + 120px);
    pointer-events: none;
    z-index: 2;
  }
  .ch05-roster {
    position: relative;
    display: flex;
    gap: 0.9rem;
    height: clamp(25rem, 54vh, 31rem);
    padding-inline: 2.75rem;
  }

  .ch05-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: flex-grow 0.75s var(--ease-run);
    -webkit-tap-highlight-color: transparent;
  }
  .ch05-card[aria-pressed='true'] {
    flex-grow: 2.45;
  }
  .ch05-card:focus-visible {
    outline: none;
  }
  .ch05-card-bg {
    position: absolute;
    inset: 0;
    transform: skewX(var(--ch05-skew));
    border-radius: 14px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01) 60%),
      rgb(11 15 56 / 0.72);
    box-shadow:
      inset 0 0 0 1px rgb(184 192 224 / 0.14),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
    transition:
      box-shadow 0.5s var(--ease-run),
      transform 0.6s var(--ease-run);
  }
  .ch05-card-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 50% at 50% 42%, rgb(77 71 254 / 0.55), transparent 70%),
      linear-gradient(160deg, rgb(56 12 116 / 0.9) 0%, rgb(30 71 243 / 0.55) 55%, rgb(25 172 254 / 0.35) 100%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-run);
  }
  .ch05-card-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 4px);
    mix-blend-mode: overlay;
  }
  .ch05-card-sweep {
    position: absolute;
    inset: -20% auto -20% -60%;
    width: 45%;
    background: linear-gradient(90deg, transparent, rgb(246 251 252 / 0.28), transparent);
    transform: skewX(-12deg) translateX(0);
    opacity: 0;
  }
  .ch05-card.is-sweeping .ch05-card-sweep {
    animation: ch05-sweep 0.9s var(--ease-run);
  }
  @keyframes ch05-sweep {
    0% {
      opacity: 1;
      transform: skewX(-12deg) translateX(0);
    }
    100% {
      opacity: 0;
      transform: skewX(-12deg) translateX(420%);
    }
  }
  .ch05-card:hover .ch05-card-bg {
    box-shadow:
      inset 0 0 0 1px rgb(184 192 224 / 0.32),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .ch05-card[aria-pressed='true'] .ch05-card-bg {
    box-shadow:
      inset 0 0 0 1.5px rgb(222 207 254 / 0.7),
      0 0 0 1px rgb(25 172 254 / 0.25),
      0 0 60px -6px rgb(77 71 254 / 0.6),
      0 40px 80px -30px rgb(0 0 0 / 0.9);
  }
  .ch05-card[aria-pressed='true'] .ch05-card-bg::before {
    opacity: 1;
  }
  .ch05-card:focus-visible .ch05-card-bg {
    box-shadow:
      inset 0 0 0 2px var(--color-sky-400),
      0 0 0 4px rgb(25 172 254 / 0.25);
  }

  .ch05-card-inner {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1.4rem 1.5rem 1.6rem;
    overflow: hidden;
  }
  .ch05-card-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 4.2vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(184 192 224 / 0.35);
    transition: -webkit-text-stroke-color 0.5s;
  }
  .ch05-card[aria-pressed='true'] .ch05-card-num {
    -webkit-text-stroke-color: rgb(246 251 252 / 0.75);
  }
  .ch05-card-id {
    position: absolute;
    right: 1.1rem;
    top: 1.6rem;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(184 192 224 / 0.55);
    transition: color 0.5s;
  }
  .ch05-card[aria-pressed='true'] .ch05-card-id {
    color: var(--color-lavender-100);
  }

  .ch05-emblem {
    position: relative;
    place-self: center;
    width: clamp(5.5rem, 8vw, 7rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    transition:
      width 0.75s var(--ease-run),
      filter 0.5s;
    filter: saturate(0.35) brightness(0.75);
  }
  .ch05-card:hover .ch05-emblem {
    filter: saturate(0.8) brightness(0.95);
  }
  .ch05-card[aria-pressed='true'] .ch05-emblem {
    width: clamp(11rem, 16vw, 15rem);
    filter: none;
  }
  .ch05-emblem :global(.ch05-badge) {
    position: relative;
    width: 78%;
    height: 78%;
    overflow: visible;
    filter: drop-shadow(0 6px 18px rgb(11 15 56 / 0.6));
  }
  .ch05-card[aria-pressed='true'] .ch05-emblem :global(.ch05-badge) {
    filter: drop-shadow(0 0 22px rgb(77 71 254 / 0.75)) drop-shadow(0 0 4px rgb(222 207 254 / 0.6));
  }
  .ch05-card[aria-pressed='true'] .ch05-emblem :global(.ch05-dot) {
    animation: ch05-dot 2.8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes ch05-dot {
    50% {
      transform: translateY(-3px) scale(1.12);
    }
  }
  .ch05-ring {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    color: var(--color-lavender-300);
    opacity: 0;
    transform: scale(0.85) rotate(-30deg);
    transition:
      opacity 0.6s,
      transform 0.9s var(--ease-run);
  }
  .ch05-card[aria-pressed='true'] .ch05-ring {
    opacity: 0.55;
    transform: scale(1) rotate(0deg);
    animation: ch05-spin 40s linear infinite;
  }
  @keyframes ch05-spin {
    to {
      rotate: 360deg;
    }
  }

  .ch05-card-name {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    letter-spacing: 0.02em;
    color: var(--color-mist-300);
    white-space: nowrap;
    transition:
      color 0.4s,
      font-size 0.6s var(--ease-run);
  }
  .ch05-card[aria-pressed='true'] .ch05-card-name {
    color: var(--color-snow-50);
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
  }
  .ch05-card-tag {
    position: absolute;
    left: 1.5rem;
    bottom: calc(1.6rem + clamp(1.6rem, 2.6vw, 2.35rem) * 1.5);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-sky-200);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-run);
  }
  .ch05-card[aria-pressed='true'] .ch05-card-tag {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
  }

  /* 手機輪播的位置點 */
  .ch05-dots {
    display: none;
  }

  /* ---------- 對話框 ---------- */
  .ch05-dialog {
    position: relative;
    margin: 2.25rem 2.75rem 0;
    min-height: 7.25rem;
    padding: 1.9rem 2.25rem 2rem;
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgb(17 24 73 / 0.85), rgb(11 15 56 / 0.92)),
      var(--color-night-900);
    box-shadow:
      inset 0 0 0 1px rgb(184 192 224 / 0.16),
      0 30px 80px -40px rgb(77 71 254 / 0.6);
  }
  .ch05-dialog-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-lavender-300);
  }
  .ch05-dialog-corner--tl {
    left: -1px;
    top: -1px;
    border-right: 0;
    border-bottom: 0;
  }
  .ch05-dialog-corner--br {
    right: -1px;
    bottom: -1px;
    border-left: 0;
    border-top: 0;
  }
  .ch05-panel + .ch05-panel {
    margin-top: 1.5rem;
  }
  .ch05.is-ready .ch05-panel + .ch05-panel {
    margin-top: 0;
  }
  .ch05.is-ready .ch05-panel[data-active='false'] {
    display: none;
  }
  .ch05-plate {
    position: absolute;
    top: 0;
    left: 2.25rem;
    transform: translateY(-55%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.75rem;
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    background: var(--gradient-brand);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .ch05:not(.is-ready) .ch05-plate {
    position: static;
    transform: none;
    margin-bottom: 0.75rem;
  }
  .ch05-plate-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgb(246 251 252 / 0.8);
  }
  .ch05-line {
    font-size: clamp(1.1rem, 1.55vw, 1.4rem);
    line-height: 1.75;
    color: var(--color-snow-50);
    max-width: 52em;
  }
  /* 打字機：完整句子留在原位（撐住高度、給螢幕報讀器），上面疊一層逐字出現的文字 */
  .ch05-line {
    position: relative;
  }
  .ch05-line-typed {
    display: none;
  }
  .ch05.is-ready .ch05-line-full {
    color: transparent;
  }
  .ch05.is-ready .ch05-line-typed {
    display: block;
    position: absolute;
    inset: 0;
  }
  .ch05-caret {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-left: 0.35em;
    vertical-align: 0.05em;
    border-radius: 50%;
    background: var(--color-lavender-100);
    box-shadow: 0 0 10px rgb(222 207 254 / 0.9);
    animation: ch05-caret 1.1s steps(1) infinite;
  }
  .ch05.is-typing .ch05-caret {
    animation: none;
  }
  @keyframes ch05-caret {
    50% {
      opacity: 0;
    }
  }

  /* ---------- 手機：橫向滑動卡片 ---------- */
  @media (max-width: 767px) {
    .ch05 {
      --ch05-skew: -4deg;
    }
    .ch05-hero {
      min-height: 76dvh;
      padding-top: 12vh;
      padding-bottom: 8vh;
    }
    .ch05-title {
      font-size: clamp(3.2rem, 16.5vw, 5.5rem);
      line-height: 1.12;
    }
