---
// 我們不做什麼：三張插圖卡片，桌機橫排，手機原生橫向捲動。
import type { Copy } from '../../../i18n/copy';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const n = copy.notDo;
const pad = (i: number) => String(i).padStart(2, '0');
const illustrations = ['free-membership', 'no-sales', 'no-paid-placement'];

// 每一條拆成「主句」與「說明」：在第一個句號後斷開（中文「。」，英文「. 」）
const items = (n.items as string[]).map((s) => {
  const m = s.match(/^(.+?[。．]|.+?\.\s)(.*)$/s);
  const head = (m ? m[1] : s).trim();
  const tail = (m ? m[2] : '').trim();
  // 句首的「不」用淡紫色標出，讀起來像一個誓言
  const lead = head.startsWith('不') ? '不' : '';
  // 在逗號後斷行，避免把詞拆開
  const parts = (lead ? head.slice(1) : head).split(/(?<=[，,])\s*/);
  return { lead, parts, tail };
});
---

<section
  id="ch-07"
  data-split="07"
  data-split-name={copy.hud.splits['07']}
  class="ch07 relative"
  aria-labelledby="ch07-title"
>
  <div class="ch07-inner">
    <p class="ch07-kicker" data-ch07-fade>{n.kicker}</p>
    <h2 id="ch07-title" class="ch07-title" data-ch07-fade>{n.title}</h2>
    <ol class="ch07-list">
      {
        items.map((it, i) => (
          <li class="ch07-item" data-ch07-item>
            <span class="ch07-num" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <img class="ch07-art" src={`/illustrations/not-do/${illustrations[i]}.jpg`} alt="" width="960" height="640" loading="lazy" decoding="async" />
            <h3 class="ch07-head">
              {it.parts.map((part, k) => (
                <span class="ch07-part">
                  {k === 0 && it.lead && <span class="ch07-lead">{it.lead}</span>}
                  {part}
                </span>
              ))}
            </h3>
            {it.tail && <p class="ch07-tail">{it.tail}</p>}
            <span class="ch07-rule" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { gsap, onReady, ScrollTrigger } from '../../engine';

  onReady(({ reduced }) => {
    const root = document.getElementById('ch-07');
    if (!root) return;

    // 告訴其他層（HUD、WebGL）這一段要安靜；誰想配合就聽這個事件
    ScrollTrigger.create({
      trigger: root,
      start: 'top 60%',
      end: 'bottom 40%',
      onToggle: (self) => window.dispatchEvent(new CustomEvent('anf:quiet', { detail: { active: self.isActive } })),
    });

    if (reduced) return;

    gsap.from(root.querySelectorAll('[data-ch07-fade], [data-ch07-item]'), {
      opacity: 0, y: 18, duration: 0.55, stagger: 0.07, ease: 'power2.out',
      scrollTrigger: { trigger: root, start: 'top 82%', toggleActions: 'play none none none' },
    });
  });
</script>

<style>
  .ch07 { background: var(--color-night-950); padding-block: clamp(3rem, 7vh, 5rem); }
  .ch07-inner { width: min(100% - 2.5rem, 78rem); margin-inline: auto; }
  .ch07-kicker { font: 0.75rem var(--font-mono); letter-spacing: 0.2em; color: var(--color-mist-300); }
  .ch07-title { margin-top: 1rem; font: 600 clamp(1.5rem, 2.6vw, 2.4rem)/1.4 'Noto Sans TC', var(--font-sans); color: var(--color-snow-50); }
  .ch07-list { margin: 2rem 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .ch07-item { position: relative; min-width: 0; padding: 0 0 1.6rem; overflow: hidden; border: 1px solid rgb(184 192 224 / 0.17); border-radius: 1.2rem; background: linear-gradient(150deg, #101638, #080c25); transition: border-color 0.3s, transform 0.3s; }
  .ch07-item:hover { border-color: rgb(143 216 255 / 0.45); transform: translateY(-4px); }
  .ch07-num { position: absolute; top: 1rem; left: 1rem; z-index: 1; padding: 0.3rem 0.5rem; border-radius: 0.4rem; background: rgb(7 10 38 / 0.8); color: var(--color-mist-300); font: 0.7rem var(--font-mono); }
  .ch07-art { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .ch07-head { margin: 1.35rem 1.4rem 0; font: 700 clamp(1.5rem, 2.15vw, 2rem)/1.3 'Noto Sans TC', var(--font-display); color: var(--color-snow-50); }
  .ch07-lead { color: var(--color-lavender-300); }
  .ch07-tail { margin: 0.8rem 1.4rem 0; color: var(--color-mist-300); font-size: 0.95rem; line-height: 1.75; }
  .ch07-rule { display: none; }
  @media (max-width: 767px) {
    .ch07-list { display: flex; overflow-x: auto; gap: 1rem; padding-bottom: 0.8rem; scroll-snap-type: x mandatory; scrollbar-color: #7772b8 #101638; }
    .ch07-item { flex: 0 0 86%; scroll-snap-align: start; }
    .ch07-item:hover { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .ch07-item { transition: none; } .ch07-item:hover { transform: none; } }
</style>
