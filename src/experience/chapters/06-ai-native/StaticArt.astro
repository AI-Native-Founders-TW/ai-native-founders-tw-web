---
// 章節 06 的靜態畫面：沒有 JS、減少動態、低效能時的正式設計。
// 同一座台灣畫成三層，一條光線貫穿三層，再向外延伸；島內保留連線。全部在建置時產生。
import { at, field, making, organization, type Pt, product } from './layers';
import { TAIWAN_ISLETS, TAIWAN_MAIN } from './taiwan';

interface Props {
  names: string[];
}
const { names } = Astro.props;

const W = 900;
const H = 960;
const S = 470; // 本島南北長度（px）
const FLOOR = 214; // 層距
const ROT = 0.62;
const SQUASH = 0.58;
const cx = 400;
const baseY = 690;

/** 島面座標 → 畫面座標：旋轉後壓扁，得到斜看的樓層。 */
const iso = ([x, y]: Pt, floor: number): Pt => {
  const rx = (x * Math.cos(ROT) - y * Math.sin(ROT)) * S;
  const ry = (x * Math.sin(ROT) + y * Math.cos(ROT)) * S * SQUASH;
  return [cx + rx, baseY - floor * FLOOR + ry];
};
const fmt = (p: Pt) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
const ring = (r: number[], floor: number) => {
  let d = '';
  for (let i = 0; i < r.length; i += 2) d += `${i ? 'L' : 'M'}${fmt(iso([r[i], r[i + 1]], floor))}`;
  return `${d}Z`;
};
const coast = (floor: number) => ring(TAIWAN_MAIN, floor);
const islets = (floor: number) => TAIWAN_ISLETS.map((r) => ring(r, floor)).join('');
/** 海岸線往外擴散的線：把輪廓放大，畫在最下層之下。 */
const ripple = (k: number) => {
  const r = TAIWAN_MAIN.map((v) => v * k);
  return ring(r, -0.28);
};
const line = (a: Pt, b: Pt, floor: number) => {
  const p = iso(a, floor);
  const q = iso(b, floor);
  const mx = (p[0] + q[0]) / 2;
  const my = (p[1] + q[1]) / 2 - Math.hypot(q[0] - p[0], q[1] - p[1]) * 0.08;
  return `M${fmt(p)}Q${mx.toFixed(1)} ${my.toFixed(1)} ${fmt(q)}`;
};

const graphs = [organization(), product(), making()];
const tints = ['#ceabfd', '#a5a8ff', '#5cc3ff'];
const loop = graphs[2].loop ?? [];
const loopD = loop
  .filter((_, i) => i % 3 === 0)
  .map((p, i) => `${i ? 'L' : 'M'}${fmt(iso(p, 2))}`)
  .join('');

// 島內連線：只取一部分，保持可讀
const net = field(46, 7);
const netPaths = net.links.slice(0, 44).map(([i, j]) => line(net.points[i], net.points[j], 2));

// 貫穿三層的光線
const hubA = iso(at(0, 0), 0);
const hubB = iso(at(-0.14, 0.14), 1);
const hubC = iso(at(0.12, 0), 2);
const threadD = `M${hubA[0].toFixed(1)} ${(hubA[1] + 120).toFixed(1)}L${fmt(hubA)}C${(hubA[0] + 110).toFixed(1)} ${(hubA[1] - 70).toFixed(1)} ${(hubB[0] + 90).toFixed(1)} ${(hubB[1] + 80).toFixed(1)} ${fmt(hubB)}C${(hubB[0] - 90).toFixed(1)} ${(hubB[1] - 70).toFixed(1)} ${(hubC[0] - 70).toFixed(1)} ${(hubC[1] + 70).toFixed(1)} ${fmt(hubC)}L${hubC[0].toFixed(1)} ${(hubC[1] - 150).toFixed(1)}`;

// 向外的連線：終點不落在任何標記上，是願景示意
const top: Pt = [hubC[0], hubC[1] - 150];
const arcs = [
  [-400, 150],
  [-360, 40],
  [-270, -40],
  [-120, -92],
  [150, -96],
  [320, -40],
  [470, 60],
  [500, 190],
].map(([dx, dy]) => {
  const ex = top[0] + dx;
  const ey = top[1] + dy;
  return `M${fmt(top)}Q${(top[0] + dx * 0.42).toFixed(1)} ${(top[1] + dy - 96).toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`;
});

// 層名放在北端外側，不壓到島與內容
const anchors = [0, 1, 2].map((f) => iso(at(0.62, 0.92), f));
---

<svg class="ch06-art" viewBox={`0 0 ${W} ${H}`} role="presentation" focusable="false" preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id="ch06-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1e47f3" stop-opacity="0.26"></stop>
      <stop offset="1" stop-color="#380c74" stop-opacity="0.2"></stop>
    </linearGradient>
    <linearGradient id="ch06-thread" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#19acfe" stop-opacity="0"></stop>
      <stop offset="0.14" stop-color="#8fd8ff"></stop>
      <stop offset="1" stop-color="#f6fbfc"></stop>
    </linearGradient>
    <linearGradient id="ch06-arc" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#f6fbfc" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#8fd8ff" stop-opacity="0"></stop>
    </linearGradient>
    <filter id="ch06-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="7"></feGaussianBlur>
    </filter>
  </defs>

  <g fill="none" stroke="#19acfe">
    {[1.22, 1.5, 1.86, 2.3].map((k, i) => (
      <path d={ripple(k)} stroke-width="1" stroke-opacity={0.42 - i * 0.09}></path>
    ))}
  </g>

  <g class="ch06-art-arcs" fill="none" stroke="url(#ch06-arc)" stroke-width="1.3">
    {arcs.map((d) => <path d={d}></path>)}
  </g>

  {[0, 1, 2].map((f) => (
    <g>
      <path d={coast(f)} transform="translate(0 9)" fill={tints[f]} fill-opacity="0.12"></path>
      <path d={coast(f)} fill="url(#ch06-glass)"></path>
      <path d={islets(f)} fill={tints[f]} fill-opacity="0.5"></path>
      <path d={coast(f)} fill="none" stroke={tints[f]} stroke-width="5" stroke-opacity="0.32" filter="url(#ch06-soft)"></path>
      <path d={coast(f)} fill="none" stroke={tints[f]} stroke-width="1.4"></path>
      {graphs[f].links.filter((l) => l.end > 1).map((l) => (
        <path d={line(l.a, l.b, f)} fill="none" stroke={tints[f]} stroke-width="1" stroke-opacity="0.68"></path>
      ))}
      {f === 2 && <path d={loopD} fill="none" stroke={tints[f]} stroke-width="1.3" stroke-opacity="0.8"></path>}
      {f === 2 && netPaths.map((d) => <path d={d} fill="none" stroke="#decffe" stroke-width="0.7" stroke-opacity="0.34"></path>)}
      {graphs[f].docs.map((d) => {
        const p = iso(d.p, f);
        return <rect x={p[0] - 8} y={p[1] - 22} width="16" height="21" rx="3" fill="#0b1139" stroke={tints[f]} stroke-width="1.2"></rect>;
      })}
      {graphs[f].nodes.filter((n) => n.end > 1).map((n) => {
        const p = iso(n.p, f);
        return n.kind === 'ring' ? (
          <circle cx={p[0]} cy={p[1]} r="4.4" fill="#070a26" stroke={tints[f]} stroke-width="1.2"></circle>
        ) : n.kind === 'dot' ? (
          <circle cx={p[0]} cy={p[1]} r="2.4" fill={tints[f]}></circle>
        ) : (
          <circle cx={p[0]} cy={p[1]} r="6.4" fill="#f6fbfc"></circle>
        );
      })}
    </g>
  ))}

  <path d={threadD} fill="none" stroke="#8fd8ff" stroke-width="7" stroke-opacity="0.3" filter="url(#ch06-soft)"></path>
  <path d={threadD} fill="none" stroke="url(#ch06-thread)" stroke-width="2"></path>

  {anchors.map((p, i) => (
    <text x={p[0] + 26} y={p[1] + 8} class="ch06-art-name" fill={tints[i]}>{names[i]}</text>
  ))}
</svg>

<style>
  .ch06-art {
    display: none;
    width: 100%;
    height: 100%;
  }
  :global(.ch06[data-mode='static']) .ch06-art {
    display: block;
  }
  .ch06-art-name {
    font-family: 'Noto Sans TC', var(--font-sans);
    font-weight: 700;
    font-size: 19px;
  }
  @media (max-width: 899px) {
    :global(.ch06[data-mode='static']) .ch06-art {
      height: auto;
      aspect-ratio: 900 / 960;
    }
  }
</style>
