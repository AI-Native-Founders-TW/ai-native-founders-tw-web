---
// 章節 06：為什麼是 AI-Native？同一座台灣分成組織本身、產品本身、產品的設計和開發三層，
// 一條光線貫穿三層後，畫面拉開到台灣與全球。文字全部是真實 HTML，WebGL 只負責畫面。
import { links } from '../../../config/links';
import type { Copy } from '../../../i18n/copy';
import { phrases } from '../../engine/phrase';
import StaticArt from './StaticArt.astro';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const a = copy.aiNative;
interface LayerCopy {
  name: string;
  body: string;
  link?: string;
  tags: { hub?: string; items: string[] };
}
const layers = a.layers as LayerCopy[];
const pad = (n: number) => String(n).padStart(2, '0');
// 標題在逗號後斷行，避免把詞拆開
const titleParts: string[] = String(a.title).split(/(?<=[，,])\s*/);
// 收尾主標：中文一行、founders 一行
const closeParts: string[] = String(a.close.title).split(/(?=AI-Native)/);
---

<section
  id="ch-06"
  data-split="06"
  data-split-name={copy.hud.splits['06']}
  data-mode="static"
  class="ch06 relative isolate"
  aria-labelledby="ch06-title"
>
  <!-- 預先決定版面，避免 JS 就緒時章節高度改變；品質偵測結果出來後由 scene.ts 校正 -->
  <script is:inline>
    (function () {
      var r = document.currentScript.parentElement;
      try {
        var q = new URLSearchParams(location.search).get('quality') || sessionStorage.getItem('anf:quality');
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          sessionStorage.getItem('anf:skip-run') === '1' ||
          q === 'low' ||
          innerHeight < 520
        )
          return;
        r.dataset.mode = 'live';
      } catch (e) {}
    })();
  </script>

  <div class="ch06-stage" data-ch06-stage aria-hidden="true">
    <canvas class="ch06-canvas" data-ch06-canvas></canvas>
    <div class="ch06-veil"></div>
    <div class="ch06-tags">
      {layers.map((l, i) => (
        <span class="ch06-tag ch06-tag--floor" data-layer={i} data-ch06-tag={`floor:${i}:0`}>
          <b>{pad(i + 1)}</b>{l.name}
        </span>
      ))}
      {layers.map((l, i) => (
        <Fragment>
          {l.tags.hub && (
            <span class="ch06-tag ch06-tag--label" data-layer={i} data-ch06-tag={`label:${i}:hub`}>{l.tags.hub}</span>
          )}
          {l.tags.items.map((t, k) => (
            <span class="ch06-tag ch06-tag--label" data-layer={i} data-ch06-tag={`label:${i}:${k}`}>{t}</span>
          ))}
        </Fragment>
      ))}
    </div>
    <StaticArt names={layers.map((l) => l.name)} />
  </div>

  <div class="ch06-flow" data-ch06-flow>
    <div class="ch06-beat ch06-beat--open" data-beat="open">
      <div class="ch06-frame">
        <header class="ch06-copy ch06-open">
          <p class="ch06-kicker" data-ch06-kicker data-fx="0">{a.kicker}</p>
          <h2 id="ch06-title" class="ch06-title" data-fx="1">
            {titleParts.map((part) => (
              <span class="ch06-title-part">
                {phrases(part).map((w) => (w.trim() ? <span class="phrase">{w}</span> : w))}
              </span>
            ))}
          </h2>
          <p class="ch06-body" data-fx="2">{a.body}</p>
        </header>
      </div>
    </div>

    <ol class="ch06-layers">
      {layers.map((l, i) => (
        <li class="ch06-beat ch06-beat--layer" data-layer={i} data-beat={`l${i + 1}`}>
          <div class="ch06-frame">
            <div class="ch06-copy">
              <p class="ch06-num" data-fx="0" aria-hidden="true">{pad(i + 1)}</p>
              <h3 class="ch06-name" data-fx="1">{l.name}</h3>
              <p class="ch06-body" data-fx="2">{l.body}</p>
              {l.link && (
                <a class="ch06-link" href={links.mono} target="_blank" rel="noopener" data-fx="3">
                  <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                  <span>{l.link}</span>
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="ch06-beat ch06-beat--weave" data-beat="weave">
      <div class="ch06-frame">
        <div class="ch06-copy">
          <p class="ch06-weave" data-fx="0">{a.weave}</p>
        </div>
      </div>
    </div>

    <div class="ch06-beat ch06-beat--close" data-beat="close">
      <div class="ch06-frame">
        <div class="ch06-copy ch06-close">
          <h3 class="ch06-close-title" data-fx="0">
            {closeParts.map((part) => <span class="ch06-title-part">{part}</span>)}
          </h3>
          <p class="ch06-body" data-fx="1">{a.close.body}</p>
        </div>
        <ul class="ch06-outcomes">
          {(a.close.outcomes as string[]).map((o, i) => (
            <li class="ch06-outcome" data-layer={i === 0 ? 2 : 0} data-ch06-outcome>{o}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { initAiNative } from './scene';
  initAiNative();
</script>

<style>
  .ch06 {
    --c-0: #ceabfd;
    --c-1: #a5a8ff;
    --c-2: #5cc3ff;
    --ch06-gutter: max(1.25rem, calc((100vw - 78rem) / 2));
    background: var(--color-night-950);
  }
  [data-layer='0'] {
    --c: var(--c-0);
  }
  [data-layer='1'] {
    --c: var(--c-1);
  }
  [data-layer='2'] {
    --c: var(--c-2);
  }

  /* ---------- 文字 ---------- */
  .ch06-kicker {
    font-family: 'Noto Sans TC', var(--font-sans);
    font-weight: 700;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    letter-spacing: 0.04em;
    color: var(--color-lavender-100);
    width: fit-content;
    transform-origin: left center;
  }
  .ch06-title {
    margin-top: 1.1rem;
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 3.3vw, 3.25rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .ch06-title .ch06-title-part {
    display: block;
  }
  .ch06-close-title .ch06-title-part {
    display: inline-block;
  }
  .ch06-body {
    margin-top: 1.5rem;
    font-size: clamp(1.02rem, 1.2vw, 1.14rem);
    line-height: 1.9;
    color: var(--color-mist-300);
    max-width: 31em;
  }
  .ch06-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-top: 1.1rem;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-snow-50);
    text-decoration: none;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 45%, transparent);
    transition:
      background 0.3s var(--ease-run),
      box-shadow 0.3s var(--ease-run);
  }
  .ch06-link:hover,
  .ch06-link:focus-visible {
    background: rgb(255 255 255 / 0.1);
    box-shadow:
      inset 0 0 0 1px var(--c),
      0 0 26px -8px var(--c);
  }
  .ch06-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--c);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ch06-num::after {
    content: '';
    width: 3.25rem;
    height: 1px;
    background: linear-gradient(90deg, var(--c), transparent);
  }
  .ch06-name {
    margin-top: 0.85rem;
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 800;
    font-size: clamp(2.3rem, 4.1vw, 3.9rem);
    line-height: 1.16;
    letter-spacing: -0.015em;
  }
  .ch06-weave {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 4.6vw, 4.4rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ch06-close-title {
    font-family: 'Noto Sans TC', var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 4.5vw, 4.6rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
  }
  .ch06-close-title .ch06-title-part:last-child {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  .ch06-outcome {
    font-family: 'Noto Sans TC', var(--font-sans);
    font-weight: 700;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    color: var(--color-snow-50);
    white-space: nowrap;
  }

  /* ---------- 靜態版：沒有 JS、減少動態、低效能、手機橫向 ---------- */
  .ch06[data-mode='static'] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    width: min(100% - 2.5rem, 78rem);
    margin-inline: auto;
    padding-block: clamp(7rem, 18vh, 12rem);
  }
  .ch06[data-mode='static'] .ch06-stage {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 6svh;
    height: 88svh;
    min-height: 26rem;
  }
  .ch06[data-mode='static'] .ch06-flow {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: clamp(4rem, 12vh, 7rem);
  }
  .ch06[data-mode='static'] .ch06-layers {
    display: grid;
    gap: clamp(3.5rem, 10vh, 6rem);
  }
  .ch06[data-mode='static'] :is(.ch06-canvas, .ch06-tags, .ch06-veil) {
    display: none;
  }
  .ch06[data-mode='static'] .ch06-kicker {
    margin-bottom: 0;
  }
  .ch06[data-mode='static'] .ch06-outcomes {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.6rem;
  }
  .ch06[data-mode='static'] .ch06-outcome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ch06[data-mode='static'] .ch06-outcome::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--c), transparent);
  }
  .ch06[data-mode='static'] .ch06-name {
    font-size: clamp(2.1rem, 3.3vw, 3.1rem);
  }
  .ch06[data-mode='static'] .ch06-close-title {
    font-size: clamp(2.15rem, 3.3vw, 3.05rem);
  }
  @media (max-width: 899px) {
    .ch06[data-mode='static'] {
      grid-template-columns: minmax(0, 1fr);
      padding-block: clamp(5rem, 12vh, 8rem);
    }
    .ch06[data-mode='static'] .ch06-stage {
      grid-column: 1;
      grid-row: 2;
      position: relative;
      top: auto;
      height: auto;
      min-height: 0;
      margin-block: 2.5rem 0;
    }
    .ch06[data-mode='static'] .ch06-flow {
      display: contents;
    }
    .ch06[data-mode='static'] .ch06-beat--open {
      grid-row: 1;
    }
    .ch06[data-mode='static'] .ch06-layers {
      grid-row: 3;
      margin-top: 3rem;
    }
    .ch06[data-mode='static'] .ch06-beat--weave {
      grid-row: 4;
      margin-top: 3.5rem;
    }
    .ch06[data-mode='static'] .ch06-beat--close {
      grid-row: 5;
      margin-top: 3rem;
    }
  }

  /* ---------- 動畫版 ---------- */
  .ch06[data-mode='live'] {
    /* 每一段文字停留的捲動長度（不含進出場）；進出場由 --ch06-gap 決定 */
    --hold-open: 150svh;
    --hold-layer: 72svh;
    --hold-weave: 96svh;
    --hold-close: 104svh;
    --ch06-gap: 84svh;
  }
  .ch06[data-mode='live'] .ch06-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    z-index: 0;
  }
  .ch06-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s var(--ease-run);
  }
  .ch06[data-gl='on'] .ch06-canvas {
    opacity: 1;
  }
  /* 讓文字讀得清楚的暗部，同時把上下邊緣收進前後章節的底色 */
  .ch06-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(7 10 38 / 0.86) 0%, rgb(7 10 38 / 0.62) 26%, transparent 52%),
      linear-gradient(180deg, var(--color-night-950) 0%, transparent 13%),
      linear-gradient(0deg, var(--color-night-950) 0%, transparent 10%);
  }
  .ch06[data-mode='live'] .ch06-flow {
    position: relative;
    z-index: 1;
    margin-top: -100vh;
    margin-top: -100svh;
    pointer-events: none;
  }
  .ch06[data-mode='live'] .ch06-layers {
    display: contents;
  }
  .ch06[data-mode='live'] .ch06-beat {
    height: calc(100svh + var(--hold));
    margin-top: calc(var(--ch06-gap) - 100svh);
  }
  .ch06[data-mode='live'] .ch06-beat--open {
    --hold: var(--hold-open);
    margin-top: 0;
  }
  .ch06[data-mode='live'] .ch06-beat--layer {
    --hold: var(--hold-layer);
  }
  .ch06[data-mode='live'] .ch06-beat--weave {
    --hold: var(--hold-weave);
  }
  .ch06[data-mode='live'] .ch06-beat--close {
    --hold: var(--hold-close);
  }
  .ch06[data-mode='live'] .ch06-frame {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-inline: var(--ch06-gutter);
  }
  .ch06[data-mode='live'] .ch06-copy {
    width: min(33rem, 38vw);
    pointer-events: auto;
  }
  .ch06[data-mode='live'] .ch06-close {
    width: min(48rem, 56vw);
  }
  .ch06[data-mode='live'] .ch06-close .ch06-body {
    max-width: 30em;
  }
  /* 收尾的主標放在天空：世界在下方，光線不會經過文字 */
  .ch06[data-mode='live'] .ch06-beat--close .ch06-frame {
    align-items: flex-start;
    padding-top: 15svh;
  }
  .ch06[data-mode='live'] [data-fx] {
    will-change: opacity, transform;
  }
  .ch06[data-mode='live'] .ch06-outcomes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ch06[data-mode='live'] .ch06-outcome {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgb(9 13 48 / 0.62);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c) 45%, transparent),
      0 0 34px -10px var(--c);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* 跟著場景走的標籤（裝飾：內容都在文字段落裡） */
  .ch06-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ch06-tag {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    visibility: hidden;
    white-space: nowrap;
    font-family: 'Noto Sans TC', var(--font-sans);
    will-change: transform;
  }
  .ch06-tag--floor {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.8rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--color-mist-300);
    background: rgb(9 13 48 / 0.58);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 28%, transparent);
    transition:
      color 0.4s,
      box-shadow 0.4s,
      background 0.4s;
  }
  .ch06-tag--floor b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.76rem;
    color: var(--c);
  }
  .ch06-tag--floor.is-active {
    color: var(--color-snow-50);
    background: rgb(12 17 62 / 0.76);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c) 70%, transparent),
      0 0 26px -8px var(--c);
  }
  .ch06-tag--label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-snow-50);
    padding: 0.16rem 0.5rem;
    border-radius: 6px;
    background: rgb(7 10 38 / 0.55);
    text-shadow: 0 0 12px var(--c);
  }

  /* 手機與直向：島在上半部，文字在下半部 */
  @media (max-width: 899px), (max-aspect-ratio: 105/100) {
    .ch06[data-mode='live'] {
      --hold-open: 128svh;
      --hold-layer: 58svh;
      --hold-weave: 74svh;
      --hold-close: 84svh;
      --ch06-gap: 70svh;
    }
    .ch06-veil {
      background:
        linear-gradient(0deg, rgb(7 10 38 / 0.97) 0%, rgb(7 10 38 / 0.9) 34%, transparent 56%),
        linear-gradient(180deg, var(--color-night-950) 0%, transparent 12%);
    }
    .ch06[data-mode='live'] .ch06-frame,
    .ch06[data-mode='live'] .ch06-beat--close .ch06-frame {
      align-items: flex-end;
      padding-top: 0;
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
    }
    .ch06[data-mode='live'] .ch06-copy,
    .ch06[data-mode='live'] .ch06-close {
      width: 100%;
      max-width: 36rem;
    }
    .ch06-title {
      font-size: clamp(1.6rem, 6.9vw, 2.3rem);
    }
    .ch06-body {
      margin-top: 0.85rem;
      font-size: clamp(0.94rem, 4vw, 1.02rem);
      line-height: 1.72;
    }
    .ch06-name {
      font-size: clamp(1.85rem, 8.4vw, 2.6rem);
    }
    .ch06-weave {
      font-size: clamp(2rem, 9.4vw, 3rem);
    }
    .ch06-close-title {
      font-size: clamp(1.95rem, 8.8vw, 3rem);
    }
    .ch06-tag--floor {
      font-size: 0.76rem;
      padding: 0.26rem 0.62rem;
    }
    .ch06-tag--label {
      font-size: 0.72rem;
    }
  }
</style>
