---
import Footer from '../components/Footer.astro';
import { getCopy, getLocale } from '../i18n/copy';
import Base from '../layouts/Base.astro';
import Boot from './chapters/00-boot/Chapter.astro';
import Hero from './chapters/01-hero/Chapter.astro';
import CoffeeChat from './chapters/02-coffee-chat/Chapter.astro';
import Voyage from './chapters/03-voyage/Chapter.astro';
import SkillTree from './chapters/04-skill-tree/Chapter.astro';
import Character from './chapters/05-character/Chapter.astro';
import AiNative from './chapters/06-ai-native/Chapter.astro';
import NotDo from './chapters/07-not-do/Chapter.astro';
import Finish from './chapters/08-finish/Chapter.astro';
import Credits from './chapters/09-credits/Chapter.astro';
import Hud from './hud/Hud.astro';
import Stage from './stage/Stage.astro';

const copy = getCopy(getLocale(Astro.currentLocale));
---

<Base>
  <Boot slot="pre" copy={copy} />
  <a slot="skip" href="#ch-08" class="skip-link">{copy.meta.skip}</a>
  <Stage />
  <Hud copy={copy} />
  <main>
    <Hero copy={copy} />
    <CoffeeChat copy={copy} />
    <Voyage copy={copy} />
    <SkillTree copy={copy} />
    <Character copy={copy} />
    <AiNative copy={copy} />
    <NotDo copy={copy} />
    <Finish copy={copy} />
    <Credits copy={copy} />
  </main>
  <Footer copy={copy} />
</Base>
