---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Orb from '../experience/orb/Orb.astro';
import { getCopy, getLocale } from '../i18n/copy';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 不顯示 Header（例如 OG 圖產生頁） */
  bare?: boolean;
  noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const {
  title = copy.meta.title,
  description = copy.meta.description,
  ogImage = '/og/default.png',
  bare = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altPath =
  locale === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : `/en${Astro.url.pathname}`;
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-Hant-TW'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'zh-Hant-TW' : 'en'} href={new URL(altPath, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070a26" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="AI-Native Global Founders Speedrun Taiwan" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型非阻塞載入：中文字等寬，換字型幾乎不會造成版面位移，換來更快的首次繪製 -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" /></noscript>
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <slot name="head" />
  </head>
  <body id="top" class="min-h-dvh overflow-x-clip bg-night-950 text-snow-50">
    <!-- pre：開場遮罩（必須在任何可見內容之前）；skip：鍵盤的第一個焦點 -->
    <slot name="pre" />
    <slot name="skip" />
    {!bare && <Header />}
    {!bare && <Orb />}
    <slot />
  </body>
</html>
